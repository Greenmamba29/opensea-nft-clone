# --- GrahmOS environment ---
# Copy to `.env` and fill in. The app runs WITHOUT these (demo mode):
#   - No VITE_WORKOS_CLIENT_ID  -> auth runs in local demo mode (Enter Demo button)
#   - No ANTHROPIC_API_KEY      -> concierge uses canned white-glove replies

# WorkOS AuthKit - frontend (public) client id. Get it from the WorkOS dashboard.
# Add your deployed origin + http://localhost:8888 to AuthKit's redirect URIs.
VITE_WORKOS_CLIENT_ID=

# WorkOS - server side, for verifying access tokens in Netlify Functions.
# (Client id is enough for JWKS verification; API key only needed for User
#  Management calls you add later.)
WORKOS_CLIENT_ID=
WORKOS_API_KEY=

# Claude - powers the white-glove concierge agent (claude-opus-4-8).
ANTHROPIC_API_KEY=

# Demo mode - grants a synthetic operator when WorkOS is not configured.
# Set on the demo deploy only; leave unset in real production (fails closed).
DEMO_MODE=

# Netlify Database (Postgres) - auto-provisioned at deploy when @netlify/database
# is installed. NETLIFY_DB_URL is injected automatically; no manual wiring needed.
# Applications and quotes persist here. Locally it is emulated by the Vite plugin.

# Shopify Storefront API - per-storefront tokens come later via Neon; a single
# shared token is the v1 scaffold. Unset -> /api/shopify/catalog serves demo data.
SHOPIFY_STOREFRONT_API_TOKEN=

# Optional: Airtable ops mirror.
VITE_AIRTABLE_BASE_ID=
VITE_AIRTABLE_API_KEY=
