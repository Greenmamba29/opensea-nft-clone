# Copy to `.env` and fill in. The app runs WITHOUT these (demo mode):
#   - No VITE_WORKOS_CLIENT_ID  â†’ auth runs in local demo mode (Enter Demo button)
#   - No ANTHROPIC_API_KEY       â†’ concierge uses canned white-glove replies

# WorkOS AuthKit â€” frontend (public) client id. Get it from the WorkOS dashboard.
# Add your deployed origin + http://localhost:8888 to AuthKit's redirect URIs.
VITE_WORKOS_CLIENT_ID=

# WorkOS â€” server side, for verifying access tokens in Netlify Functions.
# (Client id is enough for JWKS verification; API key only needed for User
#  Management calls you add later.)
WORKOS_CLIENT_ID=
WORKOS_API_KEY=

# Claude â€” powers the white-glove concierge agent (claude-opus-4-8).
ANTHROPIC_API_KEY=

# Optional: Airtable ops mirror + Neon Postgres (system of record).
VITE_AIRTABLE_BASE_ID=
VITE_AIRTABLE_API_KEY=
DATABASE_URL=
